# ── Contracts ──────────────────────────────────────────────────
PRIVATE_KEY=0x...
WORLDCHAIN_SEPOLIA_RPC=https://worldchain-sepolia.g.alchemy.com/public
ALCHEMY_API_KEY=

# ── Frontend ───────────────────────────────────────────────────
NEXT_PUBLIC_WLD_APP_ID=app_staging_...
NEXT_PUBLIC_WLD_ACTION=genome_submission

# Deployed contract addresses (fill after deploy)
NEXT_PUBLIC_GENOME_REGISTRY=
NEXT_PUBLIC_RECORD_VAULT=
NEXT_PUBLIC_CONSENT_MANAGER=
NEXT_PUBLIC_HEALTH_TOKEN=

# Lab node on Azure (genome uploads from the app) — see deploy/azure/README.md
PIPELINE_API_URL=https://<label>.<region>.cloudapp.azure.com
PIPELINE_API_TOKEN=            # same value as on the VM (pipeline.env)
BEE_PROXY_TOKEN=               # same value as on the VM; used with BEE_URL/SWARM_GATEWAY=https://<lab>/bee
SWARM_GATEWAY=                 # server-side Swarm read endpoint, e.g. https://<lab>/bee

# Storage — Swarm (encrypted file bytes)
BEE_URL=http://localhost:1633
SWARM_BATCH_ID=
NEXT_PUBLIC_SWARM_GATEWAY=https://api.gateway.ethswarm.org

# Arkiv (queryable metadata) — Rabdi testnet
ARKIV_RPC_URL=https://rpc.rabdi.db-chain.testnet.arkiv.network
ARKIV_ACCESS_KEY=
ARKIV_PRIVATE_KEY=0x...
NEXT_PUBLIC_ARKIV_RPC_URL=https://rpc.rabdi.db-chain.testnet.arkiv.network

# Lab node (signs LabAttestation after running the pipeline)
LAB_PRIVATE_KEY=0x...
NEXT_PUBLIC_LAB_ATTESTATION=
NEXT_PUBLIC_STUDY_REGISTRY=

# Chain
NEXT_PUBLIC_CHAIN_ID=4801
NEXT_PUBLIC_WORLDCHAIN_RPC=https://worldchain-sepolia.g.alchemy.com/public
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# EF Anon-RPC (all browser chain reads go through it)
NEXT_PUBLIC_ANON_RPC_NETWORK=nox          # nox | nym
NEXT_PUBLIC_ANON_BOOTSTRAP_SEPOLIA_RPC=   # optional; reads the Nox specifier once
NEXT_PUBLIC_ANON_BOOTSTRAP_MAINNET_RPC=   # optional; reads the Nym specifier once
