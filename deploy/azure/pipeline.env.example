# Copy to $GC_HOME/pipeline.env on the VM (chmod 600). Never commit the real file.

# Job service
PIPELINE_API_TOKEN=            # long random secret; the same value goes in Vercel as PIPELINE_API_TOKEN
PIPELINE_ALLOWED_ORIGINS=      # app origin(s), comma-separated, e.g. https://chainome.vercel.app
PIPELINE_DRY_RUN=1             # 1 = normalize/QC/encrypt only (no Swarm/Arkiv writes). Set 0 once keys below are in.

# Swarm
BEE_URL=http://bee:1633        # local Bee (compose profile "bee"), or the gateway URL the Swarm team gives you
SWARM_BATCH_ID=
BEE_PROXY_TOKEN=               # long random secret; guards https://<LAB_DOMAIN>/bee/* — same value in Vercel

# Arkiv (Rabdi testnet)
ARKIV_ACCESS_KEY=              # hub.arkiv.network/access-keys
ARKIV_PRIVATE_KEY=             # 0x… key of the lab writer wallet, funded with tGLM (hub.arkiv.network/faucet)

# World Chain lab attestation (optional; the lab wallet must be certified in LabRegistry)
LAB_PRIVATE_KEY=
NEXT_PUBLIC_LAB_ATTESTATION=
WORLDCHAIN_SEPOLIA_RPC=https://worldchain-sepolia.g.alchemy.com/public
